# Path where LadybugDB stores the graph database
LADYBUG_DB_PATH=.compass/graph.ladybug

# LLM model to use (any LiteLLM-compatible model string)
LLM_MODEL=gpt-4o-mini

# API key for your LLM provider (OpenAI, Anthropic, etc.)
LLM_API_KEY=

# Absolute path to the repository root you want to index
REPO_ROOT=.

# API server host and port
API_HOST=127.0.0.1
API_PORT=8000

# Frontend dev server host and port
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
